{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom": [
        "node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "@blocknote/core": [
        "node_modules/@blocknote/core"
      ],
      "@blocknote/react": [
        "node_modules/@blocknote/react"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "files": [
    "public.ts",
    "../src/features/notes/workspace/NoteFavorites.tsx",
    "../src/features/notes/NotesWorkspace.tsx",
    "../src/features/notes/workspace/useUnifiedNoteIndex.ts",
    "../src/features/notes/transfer/noteLibraryImport.ts",
    "../src/features/notes/workspace/noteFavoriteActions.ts",
    "../src/features/notes/workspace/noteBulkActions.ts",
    "../src/features/notes/workspace/noteNavigationActions.ts",
    "../src/public/configuration.ts",
    "../src/public/workspace.ts",
    "../src/features/notes/workspace/NotesExplorer.tsx",
    "../src/public/manifest.ts",
    "../src/features/notes/transfer/noteLibraryExport.ts",
    "../preview/src/app/notes/NoteManagerContinuity.browser.tsx",
    "../preview/catalog.ts",
    "../preview/public.ts",
    "../src/public/contracts.ts",
    "env.d.ts",
    "main.tsx"
  ],
  "include": [],
  "exclude": []
}
